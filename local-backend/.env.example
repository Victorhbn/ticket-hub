# Porta do servidor local
PORT=8787

# Pasta onde ficam o banco (chamados.db) e os anexos
DATA_DIR=./dados

# Segredo usado para assinar os tokens de sessão. TROQUE por um valor aleatório.
AUTH_SECRET=troque-este-segredo-por-algo-aleatorio

# Origem do site que consome a API (para CORS). Use * apenas em rede interna.
CORS_ORIGIN=*
